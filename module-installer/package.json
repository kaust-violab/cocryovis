{
  "name": "@cocryovis/module-installer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Downloads and builds the external modules in server/modules.",
  "scripts": {
    "modules:install": "node --env-file-if-exists=../.env --experimental-strip-types --disable-warning=ExperimentalWarning src/install.ts",
    "tscheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
