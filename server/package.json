{
  "name": "@cocryovis/server",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "prisma:init": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:db": "npx prisma studio",
    "prisma:seed": "npx prisma db seed",
    "db:setup": "npm run prisma:deploy && npm run prisma:seed",
    "prisma:seed:users": "tsx prisma/seeds/test-users.ts",
    "start": "node dist/index.js",
    "start:prod": "npm run db:setup && npm run start",
    "dev": "tsx src/index.ts",
    "dev:env": "conda run --no-capture-output -p ./.venv tsx src/index.ts",
    "build": "tsup",
    "modules:install": "npm --prefix ../module-installer run modules:install --",
    "modules:create": "tsx src/tools/create-module-template.ts",
    "tscheck": "tsc",
    "format": "prettier --write .",
    "lint": "npx eslint .",
    "upgrade:check": "npx npm-check-updates --format group",
    "upgrade:interactive": "npx npm-check-updates -i",
    "upgrade": "npx npm-check-updates -u"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CirilBohak/vol-web-server.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CirilBohak/vol-web-server/issues"
  },
  "homepage": "https://github.com/CirilBohak/vol-web-server#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cocryovis/schemas": "1.0.0",
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "async-express-decorator": "^1.1.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "body-parser": "^2.4.0",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-fileupload": "^1.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
